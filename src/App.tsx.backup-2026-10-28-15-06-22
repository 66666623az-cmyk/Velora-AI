          .app.chat-layout .answer-mode-picker {
            gap: 6px;
          }

          .app.chat-layout .answer-mode-button {
            flex: 1 1 calc(50% - 6px);
            padding: 9px 6px;
            font-size: 12px;
          }

          .app.chat-layout .answer-mode-description {
            font-size: 11px;
          }

          .app.chat-layout .composer textarea {
            min-height: 44px;
            font-size: 16px;
          }

          .app.chat-layout .composer-note {
            font-size: 10px;
          }

          .app.chat-layout .code-block-wrapper pre {
            font-size: 12px;
            padding: 10px;
          }

          .app.chat-layout .assistant-answer table {
            display: block;
            max-width: 100%;
            overflow-x: auto;
          }

          .app.chat-layout .assistant-answer .katex-display {
            max-width: 100%;
            overflow-x: auto;
            overflow-y: hidden;
          }

          .app.chat-layout .message-copy-row .velora-copy-button {
            min-height: 34px;
            padding: 6px 10px;
          }
        }

        @media (max-width: 480px) {
          .velora-memory-panel {
            padding: 15px;
          }

          .velora-memory-form {
            flex-direction: column;
          }

          .velora-memory-form button {
            min-height: 42px;
          }

          .velora-memory-button {
            padding: 7px;
            font-size: 11px;
          }
        }

        @media (max-width: 380px) {
          .app.chat-layout .brand h1 {
            font-size: 15px;
          }

          .app.chat-layout .status {
            font-size: 10px;
          }

          .app.chat-layout .topbar {
            padding-inline: 8px;
          }

          .app.chat-layout .composer {
            padding-inline: 8px;
          }
        }
      `}</style>

      <main className={`app study-app chat-layout theme-${theme}`}>
        <aside
          className={`sidebar ${
            sidebarOpen ? "sidebar-open" : "sidebar-closed"
          }`}
          aria-label="فهرست گفت‌وگوها"
        >
          <div className="sidebar-header">
            <button
              className="new-chat-button"
              onClick={() => startNewChat()}
              type="button"
            >
              <span>＋</span> گفت‌وگوی جدید
            </button>

            <button
              className="icon-button sidebar-toggle"
              onClick={() => setSidebarOpen(false)}
              type="button"
              aria-label="بستن فهرست چت‌ها"
            >
              ×
            </button>
          </div>

          <h3 className="sidebar-title">گفت‌وگوهای قبلی</h3>

          <div className="chat-list">
            {visibleChats.map((chat) => (
              <div
                className={`chat-list-item ${
                  chat.id === activeChat?.id ? "active" : ""
                }`}
                key={chat.id}
              >
                <button
                  className="chat-select"
                  type="button"
                  onClick={() => {
                    setActiveChatId(chat.id);
                    setInput("");
                    setSelectedImage(null);
                    setImageError("");
                    setSidebarOpen(false);
                  }}
                  title={chat.title}
                >
                  <span className="chat-icon">◷</span>
                  <span className="chat-title">{chat.title}</span>
                </button>

                <button
                  className="delete-chat-button"
                  type="button"
                  onClick={() => deleteChat(chat.id)}
                  aria-label={`حذف ${chat.title}`}
                  title="حذف گفت‌وگو"
                >
                  ×
                </button>
              </div>
            ))}

            {visibleChats.length === 0 && (
              <p className="sidebar-title">
                هنوز گفت‌وگویی در این بخش نداری.
              </p>
            )}
          </div>

          <div className="sidebar-footer">
            <span className="logo small-logo">V</span>

            <div>
              <strong>
                {mode === "tutor" ? "Velora Study" : "Velora AI"}
              </strong>

              <p>
                {mode === "tutor"
                  ? `معلم هوشمند ${userName}`
                  : `دستیار هوشمند ${userName}`}
              </p>
            </div>
          </div>
        </aside>

        <section className="main-panel">
          <header className="topbar">
            <button
              className="icon-button mobile-sidebar-button"
              onClick={() => setSidebarOpen((open) => !open)}
              type="button"
              aria-label="نمایش فهرست چت‌ها"
            >
              ☰
            </button>

            <div className="brand">
              <div className="logo">V</div>

              <div>
                <h1>
                  {mode === "tutor" ? "Velora Study" : "Velora AI"}
                </h1>

                <p>
                  {mode === "tutor"
                    ? `معلم هوشمند ${userName}`
                    : `دستیار هوشمند ${userName}`}
                </p>
              </div>
            </div>

            <nav aria-label="انتخاب حالت">
              <button
                type="button"
                onClick={() => switchMode("chat")}
                aria-pressed={mode === "chat"}
                style={{
                  padding: "9px 16px",
                  borderRadius: 12,
                  border: "1px solid var(--border-color, #8885)",
                  cursor: "pointer",
                  font: "inherit",
                  background:
                    mode === "chat"
                      ? "var(--accent, #7867f5)"
                      : "transparent",
                  color: mode === "chat" ? "white" : "inherit",
                  fontWeight: mode === "chat" ? 700 : 500,
                }}
              >
                💬 چت
              </button>

              <button
                type="button"
                onClick={() => switchMode("tutor")}
                                aria-pressed={mode === "tutor"}
                style={{
                  padding: "9px 16px",
                  borderRadius: 12,
                  border: "1px solid var(--border-color, #8885)",
                  cursor: "pointer",
                  font: "inherit",
                  background:
                    mode === "tutor"
                      ? "var(--accent, #7867f5)"
                      : "transparent",
                  color: mode === "tutor" ? "white" : "inherit",
                  fontWeight: mode === "tutor" ? 700 : 500,
                }}
              >
                🎓 معلم هوشمند
              </button>
            </nav>

            <div className="chat-header-actions">
              <button
                type="button"
                className="velora-memory-button"
                onClick={() => {
                  setMemoryNotice("");
                  setMemoryPanelOpen(true);
                }}
                aria-label="مدیریت حافظه"
                title="مشاهده و مدیریت حافظه"
              >
                🧠 حافظه ({memories.length})
              </button>

              <button
                className="study-theme-button"
                type="button"
                onClick={() =>
                  setTheme((current) =>
                    current === "dark" ? "light" : "dark",
                  )
                }
                aria-label="تغییر تم"
              >
                {theme === "dark" ? "☀️" : "🌙"}
              </button>

              <span className="status">
                <span className="status-dot" />
                {loadingChatId === activeChat?.id
                  ? "در حال پاسخ‌گویی"
                  : "آماده"}
              </span>
            </div>
          </header>

          <section className="chat">
            {!activeChat || activeChat.messages.length === 0 ? (
              <div className="welcome">
                <div className="welcome-icon">✦</div>

                <h2>
                  {mode === "tutor"
                    ? `سلام ${userName}! آماده‌ای یاد بگیری؟ 🎓`
                    : `سلام ${userName}! 👋`}
                </h2>

                <p>
                  {mode === "tutor"
                    ? "موضوع یا سؤالت را بگو تا با هم قدم‌به‌قدم یاد بگیریم."
                    : "هر چیزی دوست داری بپرس یا درباره‌اش گپ بزن."}
                </p>

                <div className="suggestions">
                  {mode === "tutor" ? (
                    <>
                      <button
                        type="button"
                        onClick={() =>
                          setInput(
                            "کسرها را با مثال ساده و مرحله‌به‌مرحله به من یاد بده.",
                          )
                        }
                      >
                        ➗ آموزش یک موضوع
                      </button>

                      <button
                        type="button"
                        onClick={() =>
                          setInput(
                            "یک آزمون کوتاه از من بگیر و بعد جواب‌هایم را بررسی کن.",
                          )
                        }
                      >
                        📝 آزمون تمرینی
                      </button>

                      <button
                        type="button"
                        onClick={() =>
                          setInput(
                            "این موضوع را ساده توضیح بده و در پایان یک سؤال برای تمرین از من بپرس.",
                          )
                        }
                      >
                        💡 تمرین و یادگیری
                      </button>
                    </>
                  ) : (
                    <>
                      <button
                        type="button"
                        onClick={() =>
                          setInput("سلام! خودت را معرفی کن.")
                        }
                      >
                        👋 شروع گفت‌وگو
                      </button>

                      <button
                        type="button"
                        onClick={() =>
                          setInput("چند ایدهٔ خلاقانه و جالب پیشنهاد بده.")
                        }
                      >
                        ✨ ایده‌پردازی
                      </button>

                      <button
                        type="button"
                        onClick={() =>
                          setInput("این متن را خلاصه و ساده کن: ")
                        }
                      >
                        📝 کمک با متن
                      </button>
                    </>
                  )}
                </div>
              </div>
            ) : (
              <div className="messages">
                {activeChat.messages.map((message, index) => {
                  const messageKey = `${activeChat.id}-${index}`;

                  const isStreaming =
                    streamingMessageKey === messageKey &&
                    loadingChatId === activeChat.id;

                  return (
                    <div
                      className={`message ${message.role}`}
                      key={messageKey}
                    >
                      <span className="message-label">
                        {message.role === "user"
                          ? userName
                          : mode === "tutor"
                            ? "معلم هوشمند"
                            : "Velora AI"}
                      </span>

                      <div
                        className={
                          message.role === "assistant"
                            ? "assistant-answer"
                            : "user-message-content"
                        }
                        dir="auto"
                      >
                        {message.role === "user" && message.image && (
                          <img
                            className="user-attached-image"
                            src={message.image}
                            alt="تصویر ارسال‌شده"
                            loading="lazy"
                          />
                        )}

                        {message.role === "assistant" ? (
                          <>
                            {message.content ? (
                              <AssistantContent
                                content={message.content}
                              />
                            ) : isStreaming ? (
                              <span>در حال نوشتن پاسخ…</span>
                            ) : null}

                            {isStreaming && (
                              <span
                                className="streaming-cursor"
                                aria-hidden="true"
                              >
                                ▍
                              </span>
                            )}
                          </>
                        ) : (
                          message.content
                        )}
                      </div>

                      {message.content.trim() !== "" && (
                        <div className="message-copy-row">
                          <CopyButton
                            text={message.content}
                            label={
                              message.role === "user"
                                ? "کپی سؤال"
                                : "کپی پاسخ"
                            }
                          />
                        </div>
                      )}
                    </div>
                  );
                })}
              </div>
            )}
          </section>

          <form
            className="composer"
            onSubmit={(event) => {
              event.preventDefault();
              void sendMessage();
            }}
          >
            <div
              className="answer-mode-picker"
              aria-label="حالت پاسخ‌گویی"
            >
              <button
                className="answer-mode-button"
                type="button"
                aria-pressed={answerMode === "fast"}
                onClick={() => setAnswerMode("fast")}
                disabled={loadingChatId !== null}
                title="پاسخ سریع برای سؤال‌های معمولی"
              >
                ⚡ پاسخ سریع
              </button>

              <button
                className="answer-mode-button"
                type="button"
                aria-pressed={answerMode === "deep"}
                onClick={() => setAnswerMode("deep")}
                disabled={loadingChatId !== null}
                title="برای مسائل پیچیده و چندمرحله‌ای"
              >
                🧠 تفکر عمیق
              </button>

              <p className="answer-mode-description">
                {answerMode === "deep"
                  ? "تفکر عمیق فعال است؛ ممکن است پاسخ دیرتر آماده شود."
                  : "پاسخ سریع فعال است؛ مناسب سؤال‌های روزمره."}
              </p>
            </div>

            <div className="velora-image-controls">
              <input
                id="velora-image-input"
                className="velora-image-input"
                type="file"
                accept="image/jpeg,image/png,image/webp"
                disabled={loadingChatId !== null}
                onChange={handleImageSelect}
                aria-label="انتخاب عکس"
              />

              <button
                className="velora-image-button"
                type="button"
                disabled={loadingChatId !== null}
                onClick={() =>
                  document.getElementById("velora-image-input")?.click()
                }
                aria-label="پیوست عکس"
                title="پیوست عکس"
              >
                📎 افزودن عکس
              </button>

              {selectedImage && (
                <div className="velora-image-preview" dir="rtl">
                  <img
                    src={selectedImage.dataUrl}
                    alt="پیش‌نمایش عکس"
                  />

                  <span className="velora-image-preview-name">
                    {selectedImage.name}
                  </span>

                  <button
                    type="button"
                    onClick={() => {
                      setSelectedImage(null);
                      setImageError("");
                    }}
                    aria-label="حذف عکس انتخاب‌شده"
                    title="حذف عکس"
                  >
                    ×
                  </button>
                </div>
              )}

              {imageError && (
                <p className="velora-image-error" role="alert">
                  {imageError}
                </p>
              )}

              {selectedImage && (
                <p className="velora-image-storage-note">
                  عکس پس از بارگذاری مجدد صفحه در تاریخچه باقی نمی‌ماند.
                </p>
              )}
            </div>

            <textarea
              value={input}
              onChange={(event) => setInput(event.target.value)}
              onKeyDown={(event) => {
                if (
                  event.key === "Enter" &&
                  !event.shiftKey &&
                  !event.nativeEvent.isComposing
                ) {
                  event.preventDefault();
                  void sendMessage();
                }
              }}
              placeholder={
                mode === "tutor"
                  ? `${userName}، سؤالت رو بپرس تا با هم یاد بگیریم...`
                  : `${userName}، پیامت رو بنویس...`
              }
              rows={1}
              aria-label="پیام شما"
            />

            <button
              className="send-button"
              type="submit"
              disabled={
                (!input.trim() && !selectedImage) ||
                loadingChatId !== null
              }
              aria-label="ارسال پیام"
            >
              ↑
            </button>

            <p className="composer-note">
              گفت‌وگوها، اسمت و حافظه‌ها در همین مرورگر ذخیره می‌شوند.
            </p>
          </form>
        </section>

        {memoryPanelOpen && (
          <div className="velora-memory-overlay">
            <section
              className={`velora-memory-panel ${
                theme === "light" ? "memory-light" : ""
              }`}
              dir="rtl"
              role="dialog"
              aria-modal="true"
              aria-labelledby="velora-memory-title"
            >
              <header className="velora-memory-header">
                <div>
                  <h2 id="velora-memory-title">🧠 حافظهٔ Velora</h2>

                  <p>
                    علایق و اطلاعاتی که برای گفت‌وگوهای بعدی ذخیره شده‌اند
                  </p>
                </div>

                <button
                  type="button"
                  onClick={() => setMemoryPanelOpen(false)}
                  aria-label="بستن پنل حافظه"
                >
                  ×
                </button>
              </header>

              <form
                className="velora-memory-form"
                onSubmit={(event) => {
                  event.preventDefault();
                  addMemory(memoryInput);
                }}
              >
                <input
                  value={memoryInput}
                  onChange={(event) => {
                    setMemoryInput(event.target.value);
                    setMemoryNotice("");
                  }}
                  placeholder="مثلاً به یادگیری پایتون علاقه دارم"
                  maxLength={160}
                  aria-label="حافظهٔ جدید"
                />

                <button type="submit">ذخیره</button>
              </form>

              {memoryNotice && (
                <p className="velora-memory-notice" role="status">
                  {memoryNotice}
                </p>
              )}

              <div className="velora-memory-list">
                {memories.length === 0 ? (
                  <p className="velora-memory-empty">
                    هنوز حافظه‌ای ذخیره نشده است.
                    <br />
                    می‌توانی موردی را بالا اضافه کنی یا در چت بنویسی:
                    <br />
                    «من به برنامه‌نویسی علاقه دارم».
                  </p>
                ) : (
                  memories.map((memory) => (
                    <div
                      className="velora-memory-item"
                      key={memory.id}
                    >
                      <span>{memory.text}</span>

                      <button
                        type="button"
                        onClick={() => deleteMemory(memory.id)}
                        aria-label={`حذف حافظه ${memory.text}`}
                      >
                        حذف
                      </button>
                    </div>
                  ))
                )}
              </div>

              <p className="velora-memory-footer">
                حافظه‌ها در همین مرورگر ذخیره می‌شوند و همراه پیام‌های جدید
                برای هوش مصنوعی ارسال می‌شوند. حداکثر ظرفیت: {MAX_MEMORIES} مورد.
              </p>
            </section>
          </div>
        )}
      </main>
    </>
  );
}

export default App;