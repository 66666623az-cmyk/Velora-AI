import { useEffect, useState, type ChangeEvent, type FormEvent, type ReactNode } from "react";
import ReactMarkdown from "react-markdown";
import remarkGfm from "remark-gfm";
import remarkMath from "remark-math";
import rehypeKatex from "rehype-katex";
import "katex/dist/katex.min.css";
import "./App.css";

type Role = "user" | "assistant";
type AppMode = "chat" | "tutor";
type AnswerMode = "fast" | "deep";
type Theme = "dark" | "light";

type Message = {
  role: Role;
  content: string;
  image?: string;
};

type Chat = {
  id: string;
  title: string;
  messages: Message[];
  updatedAt: number;
  mode: AppMode;
};

type UserMemory = {
  id: string;
  text: string;
  createdAt: number;
};

const API_URL =
  "https://velora-ai-server.velora-ai-mohammad.workers.dev/api/chat";

const STORAGE_KEY = "velora-ai-chats-v1";
const THEME_KEY = "velora-study-theme-v1";
const ANSWER_MODE_KEY = "velora-ai-answer-mode-v1";
const APP_MODE_KEY = "velora-app-mode-v1";
const USER_NAME_KEY = "velora-user-name-v1";
const MEMORY_KEY = "velora-study-memories-v1";
const MAX_MEMORIES = 50;

function createId(): string {
  return crypto.randomUUID();
}

function createChat(mode: AppMode): Chat {
  return {
    id: createId(),
    title: "گفت‌وگوی جدید",
    messages: [],
    updatedAt: Date.now(),
    mode,
  };
}

function isRole(value: unknown): value is Role {
  return value === "user" || value === "assistant";
}

function loadMemories(): UserMemory[] {
  try {
    const saved = localStorage.getItem(MEMORY_KEY);
    if (!saved) return [];

    const parsed: unknown = JSON.parse(saved);
    if (!Array.isArray(parsed)) return [];

    return parsed
      .filter(
        (item): item is UserMemory =>
          !!item &&
          typeof item === "object" &&
          typeof item.id === "string" &&
          typeof item.text === "string" &&
          typeof item.createdAt === "number",
      )
      .filter(
        (item) =>
          item.text.trim().length > 0 &&
          item.text.length <= 160,
      )
      .slice(0, MAX_MEMORIES);
  } catch {
    return [];
  }
}

function detectMemory(text: string): string | null {
  const normalized = text.trim().replace(/\s+/g, " ");

  const patterns = [
    {
      regex: /(?:من\s*)?به\s+(.+?)\s+علاقه\s+دارم[.!؟،]?$/u,
      format: (fact: string) => `علاقه کاربر: ${fact}`,
    },
    {
      regex: /(?:من\s*)?علاقه‌مندم\s+به\s+(.+?)[.!؟،]?$/u,
      format: (fact: string) => `علاقه کاربر: ${fact}`,
    },
    {
      regex: /(?:یادت باشه|یادت بمونه|به خاطر بسپار)\s*[:،]?\s*(.+)$/u,
      format: (fact: string) => fact,
    },
  ];

  for (const pattern of patterns) {
    const match = normalized.match(pattern.regex);
    const fact = match?.[1]?.trim();

    if (fact && fact.length >= 2 && fact.length <= 160) {
      return pattern.format(fact);
    }
  }

  return null;
}

function loadChats(): Chat[] {
  try {
    const saved = localStorage.getItem(STORAGE_KEY);
    if (!saved) return [];

    const parsed: unknown = JSON.parse(saved);
    if (!Array.isArray(parsed)) return [];

    return parsed.flatMap((item: unknown): Chat[] => {
      if (!item || typeof item !== "object") return [];

      const value = item as Record<string, unknown>;

      if (
        typeof value.id !== "string" ||
        typeof value.title !== "string" ||
        typeof value.updatedAt !== "number" ||
        !Array.isArray(value.messages)
      ) {
        return [];
      }

      const validMessages = value.messages.every(
        (message: unknown) => {
          if (!message || typeof message !== "object") return false;

          const entry = message as Record<string, unknown>;

          return (
            isRole(entry.role) &&
            typeof entry.content === "string"
          );
        },
      );

      if (!validMessages) return [];

      return [
        {
          id: value.id,
          title: value.title,
          updatedAt: value.updatedAt,
          messages: value.messages as Message[],
          mode: value.mode === "chat" ? "chat" : "tutor",
        },
      ];
    });
  } catch {
    return [];
  }
}

function loadTheme(): Theme {
  try {
    return localStorage.getItem(THEME_KEY) === "light"
      ? "light"
      : "dark";
  } catch {
    return "dark";
  }
}

function loadAnswerMode(): AnswerMode {
  try {
    return localStorage.getItem(ANSWER_MODE_KEY) === "deep"
      ? "deep"
      : "fast";
  } catch {
    return "fast";
  }
}

function loadAppMode(): AppMode {
  try {
    return localStorage.getItem(APP_MODE_KEY) === "chat"
      ? "chat"
      : "tutor";
  } catch {
    return "tutor";
  }
}

function loadUserName(): string {
  try {
    return localStorage.getItem(USER_NAME_KEY)?.trim() ?? "";
  } catch {
    return "";
  }
}

function normalizeMathText(content: string): string {
  const symbols: Record<string, string> = {
    "\\leftarrow": "←",
    "\\rightarrow": "→",
    "\\Rightarrow": "⇒",
    "\\Leftarrow": "⇐",
    "\\times": "×",
    "\\div": "÷",
    "\\pm": "±",
    "\\cdot": "·",
  };

  return content.replace(
    /\\\((\\(?:leftarrow|rightarrow|Rightarrow|Leftarrow|times|div|pm|cdot))\\\)/g,
    (match, command: string) => symbols[command] ?? match,
  );
}

function extractText(node: ReactNode): string {
  if (typeof node === "string" || typeof node === "number") {
    return String(node);
  }

  if (Array.isArray(node)) {
    return node.map(extractText).join("");
  }

  if (node && typeof node === "object" && "props" in node) {
    return extractText(
      (node as { props?: { children?: ReactNode } }).props?.children,
    );
  }

  return "";
}

function CopyButton({
  text,
  label = "کپی",
}: {
  text: string;
  label?: string;
}) {
  const [copied, setCopied] = useState(false);
  const [failed, setFailed] = useState(false);

  async function copyText() {
    try {
      await navigator.clipboard.writeText(text);
      setCopied(true);
      setFailed(false);
      window.setTimeout(() => setCopied(false), 1800);
    } catch {
      setFailed(true);
      setCopied(false);
      window.setTimeout(() => setFailed(false), 1800);
    }
  }

  return (
    <button
      type="button"
      className="velora-copy-button"
      onClick={() => void copyText()}
      aria-label={label}
      title={label}
    >
      {copied ? "✓ کپی شد" : failed ? "کپی ناموفق" : `⧉ ${label}`}
    </button>
  );
}

function CopyableCodeBlock({
  children,
}: {
  children: ReactNode;
}) {
  const codeText = extractText(children);

  return (
    <div className="code-block-wrapper" dir="ltr">
      <div className="code-block-toolbar">
        <span>Code</span>
        <CopyButton text={codeText} label="کپی کد" />
      </div>

      <pre dir="ltr">{children}</pre>
    </div>
  );
}

function AssistantContent({ content }: { content: string }) {
  return (
    <ReactMarkdown
      remarkPlugins={[remarkGfm, remarkMath]}
      rehypePlugins={[rehypeKatex]}
      components={{
        pre: ({ children }) => (
          <CopyableCodeBlock>{children}</CopyableCodeBlock>
        ),
        code: ({ children, className, ...props }) => (
          <code className={className} {...props}>
            {children}
          </code>
        ),
        a: ({ children, href, ...props }) => (
          <a
            href={href}
            target="_blank"
            rel="noreferrer"
            {...props}
          >
            {children}
          </a>
        ),
      }}
    >
      {normalizeMathText(content)}
    </ReactMarkdown>
  );
}
/**
 * حذف بخش متادیتای فنی از متن قابل نمایش پاسخ.
 * اگر مدل در پایان پاسخ خط‌هایی مثل model: یا imageModel: تولید کند،
 * آن خط و همهٔ اطلاعات فنی پس از آن به کاربر نشان داده نمی‌شود.
 */
function cleanAssistantText(text: string): string {
  const metadataPattern = /^\s*(?:model|imageModel|answerMode|searchedWeb|sources)\s*:/im;
  const match = metadataPattern.exec(text);

  if (!match || match.index === undefined) return text;
  return text.slice(0, match.index).trimEnd();
}

async function readAnswerStream(
  response: Response,
  onText: (text: string) => void,
): Promise<string> {
  if (!response.body) {
    throw new Error("سرور جریان پاسخ را پشتیبانی نمی‌کند.");
  }

  const reader = response.body.getReader();
  const decoder = new TextDecoder();
  let buffer = "";
  let fullText = "";

  function processLine(line: string) {
    const trimmed = line.trim();
    if (!trimmed) return;

    const jsonText = trimmed.startsWith("data:")
      ? trimmed.slice(5).trim()
      : trimmed;

    if (!jsonText || jsonText === "[DONE]") return;

    let data: {
      delta?: string;
      answer?: string;
      error?: string;
    };

    try {
      data = JSON.parse(jsonText) as {
        delta?: string;
        answer?: string;
        error?: string;
      };
    } catch {
      throw new Error("پاسخ ارسالی سرور معتبر نیست.");
    }

    if (data.error) throw new Error(data.error);

    if (typeof data.delta === "string" && data.delta.length > 0) {
      fullText += data.delta;
      onText(cleanAssistantText(fullText));
    } else if (
      typeof data.answer === "string" &&
      !fullText &&
      data.answer.length > 0
    ) {
      fullText = data.answer;
      onText(cleanAssistantText(fullText));
    }
  }

  try {
    while (true) {
      const { value, done } = await reader.read();
      if (done) break;

      buffer += decoder.decode(value, { stream: true });
      const lines = buffer.split("\n");
      buffer = lines.pop() ?? "";

      for (const line of lines) processLine(line);
    }

    buffer += decoder.decode();
    if (buffer.trim()) processLine(buffer);
  } catch (error) {
    try {
      await reader.cancel();
    } catch {
      // خطای لغو خواندن نادیده گرفته می‌شود.
    }
    throw error;
  } finally {
    reader.releaseLock();
  }

  const cleanedText = cleanAssistantText(fullText).trim();
  if (!cleanedText) {
    throw new Error(
      "پاسخ قابل‌نمایشی از سرور دریافت نشد. ممکن است فقط اطلاعات فنی ارسال شده باشد.",
    );
  }

  return cleanedText;
}

function App() {
  const [userName, setUserName] = useState(loadUserName);
  const [nameInput, setNameInput] = useState("");
  const [nameError, setNameError] = useState("");
  const [memories, setMemories] = useState<UserMemory[]>(loadMemories);
  const [memoryPanelOpen, setMemoryPanelOpen] = useState(false);
  const [memoryInput, setMemoryInput] = useState("");
  const [memoryNotice, setMemoryNotice] = useState("");
  const [chats, setChats] = useState<Chat[]>(() => {
    const saved = loadChats();
    return saved.length ? saved : [createChat(loadAppMode())];
  });
  const [mode, setMode] = useState<AppMode>(loadAppMode);
  const [activeChatId, setActiveChatId] = useState(
    () => loadChats()[0]?.id ?? "",
  );
  const [theme, setTheme] = useState<Theme>(loadTheme);
  const [answerMode, setAnswerMode] =
    useState<AnswerMode>(loadAnswerMode);
  const [input, setInput] = useState("");
  const [selectedImage, setSelectedImage] = useState<{
    dataUrl: string;
    name: string;
  } | null>(null);
  const [imageError, setImageError] = useState("");
  const [loadingChatId, setLoadingChatId] = useState<string | null>(
    null,
  );
  const [sidebarOpen, setSidebarOpen] = useState(false);
  const [streamingMessageKey, setStreamingMessageKey] = useState<
    string | null
  >(null);

  const visibleChats = chats
    .filter((chat) => chat.mode === mode)
    .sort((a, b) => b.updatedAt - a.updatedAt);

  const activeChat =
    visibleChats.find((chat) => chat.id === activeChatId) ??
    visibleChats[0];

  useEffect(() => {
    if (!activeChat || activeChat.id !== activeChatId) {
      setActiveChatId(activeChat?.id ?? "");
    }
  }, [activeChat, activeChatId]);

  useEffect(() => {
    try {
      // عکس‌ها فقط در نشست فعلی نمایش داده می‌شوند؛ آن‌ها را در localStorage
      // ذخیره نمی‌کنیم تا تصاویر حجیم فضای ذخیره‌سازی مرورگر را پر نکنند.
      const chatsForStorage = chats.map((chat) => ({
        ...chat,
        messages: chat.messages.map((message) => ({
          role: message.role,
          content: message.content,
        })),
      }));

      localStorage.setItem(STORAGE_KEY, JSON.stringify(chatsForStorage));
    } catch {
      console.error("ذخیرهٔ گفت‌وگوها ناموفق بود.");
    }
  }, [chats]);

  useEffect(() => {
    try {
      localStorage.setItem(THEME_KEY, theme);
    } catch {
      console.error("ذخیرهٔ تم ناموفق بود.");
    }
  }, [theme]);

  useEffect(() => {
    try {
      localStorage.setItem(ANSWER_MODE_KEY, answerMode);
      localStorage.setItem(APP_MODE_KEY, mode);

      if (userName.trim()) {
        localStorage.setItem(USER_NAME_KEY, userName.trim());
      }
    } catch {
      console.error("ذخیرهٔ تنظیمات ناموفق بود.");
    }
  }, [answerMode, mode, userName]);

  useEffect(() => {
    try {
      localStorage.setItem(MEMORY_KEY, JSON.stringify(memories));
    } catch {
      console.error("ذخیرهٔ حافظه‌ها ناموفق بود.");
    }
  }, [memories]);

  function addMemory(rawText: string): boolean {
    const text = rawText.trim().replace(/\s+/g, " ");

    if (!text) {
      setMemoryNotice("متن حافظه نمی‌تواند خالی باشد.");
      return false;
    }

    if (text.length > 160) {
      setMemoryNotice("هر حافظه حداکثر ۱۶۰ نویسه باشد.");
      return false;
    }

    const duplicate = memories.some(
      (memory) =>
        memory.text.toLocaleLowerCase() === text.toLocaleLowerCase(),
    );

    if (duplicate) {
      setMemoryNotice("این مورد از قبل در حافظه وجود دارد.");
      return false;
    }

    if (memories.length >= MAX_MEMORIES) {
      setMemoryNotice(
        "ظرفیت حافظه پر شده است؛ ابتدا یک مورد قدیمی را حذف کن.",
      );
      return false;
    }

    const newMemory: UserMemory = {
      id: createId(),
      text,
      createdAt: Date.now(),
    };

    setMemories((previous) => [newMemory, ...previous]);
    setMemoryInput("");
    setMemoryNotice("حافظه با موفقیت ذخیره شد. ✅");
    return true;
  }

  function deleteMemory(memoryId: string) {
    setMemories((previous) =>
      previous.filter((memory) => memory.id !== memoryId),
    );
    setMemoryNotice("حافظه حذف شد.");
  }

  function saveName(event: FormEvent<HTMLFormElement>) {
    event.preventDefault();

    const cleanName = nameInput.trim();

    if (!cleanName) {
      setNameError("لطفاً اسمت را وارد کن.");
      return;
    }

    if (cleanName.length > 50) {
      setNameError("اسم باید حداکثر ۵۰ نویسه باشد.");
      return;
    }

    setUserName(cleanName);
    setNameInput("");
    setNameError("");

    try {
      localStorage.setItem(USER_NAME_KEY, cleanName);
    } catch {
      // برنامه همچنان در همین نشست قابل استفاده است.
    }
  }

  function handleImageSelect(event: ChangeEvent<HTMLInputElement>) {
    const file = event.target.files?.[0];
    event.target.value = "";

    if (!file) return;

    const allowedTypes = ["image/jpeg", "image/png", "image/webp"];

    if (!allowedTypes.includes(file.type)) {
      setSelectedImage(null);
      setImageError("لطفاً یک عکس JPG، PNG یا WebP انتخاب کن.");
      return;
    }

    // Worker فعلی دادهٔ تصویر را تا حدود ۷ مگابایت می‌پذیرد؛ ۴ مگابایت
    // برای فایل اصلی، پس از تبدیل به Base64 نیز حاشیهٔ امن باقی می‌گذارد.
    if (file.size > 4 * 1024 * 1024) {
      setSelectedImage(null);
      setImageError("حجم عکس باید حداکثر ۴ مگابایت باشد.");
      return;
    }

    const reader = new FileReader();

    reader.onload = () => {
      if (typeof reader.result !== "string") {
        setSelectedImage(null);
        setImageError("خواندن عکس ناموفق بود؛ دوباره امتحان کن.");
        return;
      }

      setSelectedImage({ dataUrl: reader.result, name: file.name });
      setImageError("");
    };

    reader.onerror = () => {
      setSelectedImage(null);
      setImageError("خواندن عکس ناموفق بود؛ دوباره امتحان کن.");
    };

    reader.readAsDataURL(file);
  }

  function updateChat(
    chatId: string,
    updater: (chat: Chat) => Chat,
  ) {
    setChats((previous) =>
      previous.map((chat) =>
        chat.id === chatId ? updater(chat) : chat,
      ),
    );
  }

  function startNewChat(targetMode: AppMode = mode) {
    const chat = createChat(targetMode);

    setChats((previous) => [chat, ...previous]);
    setMode(targetMode);
    setActiveChatId(chat.id);
    setInput("");
    setSelectedImage(null);
    setImageError("");
    setStreamingMessageKey(null);
    setSidebarOpen(false);
  }

  function switchMode(targetMode: AppMode) {
    if (targetMode === mode) return;

    const existingChat = chats
      .filter((chat) => chat.mode === targetMode)
      .sort((a, b) => b.updatedAt - a.updatedAt)[0];

    setMode(targetMode);
    setInput("");
    setSelectedImage(null);
    setImageError("");
    setStreamingMessageKey(null);
    setActiveChatId(existingChat?.id ?? "");
    setSidebarOpen(false);

    if (!existingChat) {
      startNewChat(targetMode);
    }
  }

  async function sendMessage(overrideText?: string) {
    const text = (overrideText ?? input).trim();
    const imageToSend = selectedImage;

    if ((!text && !imageToSend) || !activeChat || loadingChatId !== null) {
      return;
    }

    const messageText = text || "لطفاً این تصویر را بررسی کن و توضیح بده.";
    const chatId = activeChat.id;
    const assistantMessageIndex = activeChat.messages.length + 1;

    // تشخیص علاقه یا اطلاعاتی که کاربر صریحاً خواسته ذخیره شوند.
    let memoriesForRequest = memories;
    const detectedMemory = detectMemory(text);

    if (detectedMemory) {
      const exists = memories.some(
        (memory) =>
          memory.text.toLocaleLowerCase() ===
          detectedMemory.toLocaleLowerCase(),
      );

      if (!exists && memories.length < MAX_MEMORIES) {
        const newMemory: UserMemory = {
          id: createId(),
          text: detectedMemory,
          createdAt: Date.now(),
        };

        memoriesForRequest = [newMemory, ...memories];
        setMemories(memoriesForRequest);
      }
    }

    const updatedMessages: Message[] = [
      ...activeChat.messages,
      {
        role: "user",
        content: messageText,
        ...(imageToSend ? { image: imageToSend.dataUrl } : {}),
      },
    ];

    setStreamingMessageKey(`${chatId}-${assistantMessageIndex}`);

    updateChat(chatId, (chat) => ({
      ...chat,
      title:
        chat.messages.length === 0
          ? imageToSend && !text
            ? "بررسی تصویر"
            : messageText.slice(0, 35) +
              (messageText.length > 35 ? "…" : "")
          : chat.title,
      messages: [
        ...chat.messages,
        {
          role: "user",
          content: messageText,
          ...(imageToSend ? { image: imageToSend.dataUrl } : {}),
        },
        { role: "assistant", content: "" },
      ],
      updatedAt: Date.now(),
    }));

    setInput("");
    setSelectedImage(null);
    setImageError("");
    setLoadingChatId(chatId);

    try {
      const apiMessages: Message[] = updatedMessages
        .slice(-20)
        .map((message, index, messages) => {
          // تصویر در فیلد جداگانهٔ درخواست ارسال می‌شود؛ Base64 را داخل
          // آرایهٔ پیام‌ها تکرار نمی‌کنیم.
          const apiMessage: Message = {
            role: message.role,
            content: message.content,
          };

          if (
            index !== messages.length - 1 ||
            message.role !== "user"
          ) {
            return apiMessage;
          }

          const personalNote =
            `\n\nنام کاربر ${userName} است. ` +
            "در صورت طبیعی بودن، گاهی او را با نامش خطاب کن؛ " +
            "از تکرار بیش از حد نام خودداری کن. ";

          const modeInstruction =
            mode === "tutor"
              ? "مثل یک معلم خصوصی صبور و مهربان آموزش بده. " +
                "موضوع را ساده و مرحله‌به‌مرحله توضیح بده، " +
                "مثال بزن و روش حل را نیز آموزش بده."
              : "مانند یک دستیار هوشمند، دوستانه و دقیق پاسخ بده.";

          const memoryContext =
            memoriesForRequest.length > 0
              ? "\n\nاطلاعات ذخیره‌شده از گفته‌های قبلی کاربر:\n" +
                memoriesForRequest
                  .map((memory) => `- ${memory.text}`)
                  .join("\n") +
                "\nاگر این اطلاعات به سؤال فعلی مرتبط هستند، از آن‌ها برای شخصی‌سازی پاسخ استفاده کن. " +
                "اگر مرتبط نیستند، بی‌دلیل به آن‌ها اشاره نکن. " +
                "این موارد را اطلاعات قبلی ذخیره‌شده در نظر بگیر."
              : "";

          return {
            ...apiMessage,
            content:
              apiMessage.content +
              personalNote +
              "\nراهنمای پاسخ‌گویی: " +
              modeInstruction +
              memoryContext,
          };
        });

      const response = await fetch(API_URL, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          Accept: "application/x-ndjson",
        },
        body: JSON.stringify({
          messages: apiMessages,
          answerMode,
          stream: true,
          ...(imageToSend ? { image: imageToSend.dataUrl } : {}),
        }),
      });

      if (!response.ok) {
        let errorMessage = "دریافت پاسخ ناموفق بود.";

        try {
          const errorData = (await response.json()) as {
            error?: string;
          };

          if (errorData.error) {
            errorMessage = errorData.error;
          }
        } catch {
          // بدنهٔ خطا JSON نبود.
        }

        throw new Error(errorMessage);
      }

      const answer = await readAnswerStream(
        response,
        (partialText) => {
          updateChat(chatId, (chat) => ({
            ...chat,
            messages: chat.messages.map((message, index) =>
              index === assistantMessageIndex &&
              message.role === "assistant"
                ? { ...message, content: partialText }
                : message,
            ),
            updatedAt: Date.now(),
          }));
        },
      );

      updateChat(chatId, (chat) => ({
        ...chat,
        messages: chat.messages.map((message, index) =>
          index === assistantMessageIndex &&
          message.role === "assistant"
            ? { ...message, content: answer }
            : message,
        ),
        updatedAt: Date.now(),
      }));
    } catch (error) {
      const errorMessage =
        error instanceof Error
          ? error.message
          : "ارتباط با سرور برقرار نشد.";

      updateChat(chatId, (chat) => ({
        ...chat,
        messages: chat.messages.map((message, index) =>
          index === assistantMessageIndex &&
          message.role === "assistant"
            ? {
                ...message,
                content:
                  `**خطا در دریافت پاسخ**\n\n${errorMessage}`,
              }
            : message,
        ),
        updatedAt: Date.now(),
      }));
    } finally {
      setLoadingChatId((current) =>
        current === chatId ? null : current,
      );
      setStreamingMessageKey(null);
    }
  }

