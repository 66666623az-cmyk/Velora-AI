                  background: mode === "tutor" ? "var(--accent, #7867f5)" : "transparent",
                  color: mode === "tutor" ? "white" : "inherit",
                  fontWeight: mode === "tutor" ? 700 : 500,
                }}
              >
                🎓 معلم هوشمند
              </button>
            </nav>

            <div className="chat-header-actions">
              <button
                className="study-theme-button"
                type="button"
                onClick={() => setTheme(theme === "dark" ? "light" : "dark")}
                aria-label="تغییر تم"
              >
                {theme === "dark" ? "☀️" : "🌙"}
              </button>
              <span className="status">
                <span className="status-dot" />
                {loadingChatId === activeChat?.id ? "در حال پاسخ‌گویی" : "آماده"}
              </span>
            </div>
          </header>

          <section className="chat">
            {!activeChat || activeChat.messages.length === 0 ? (
              <div className="welcome">
                <div className="welcome-icon">✦</div>
                <h2>{mode === "tutor" ? "سلام! آماده‌ای یاد بگیری؟ 🎓" : "سلام! 👋"}</h2>
                <p>
                  {mode === "tutor"
                    ? "موضوع یا سؤالت را بگو تا با هم قدم‌به‌قدم یاد بگیریم."
                    : "هر چیزی دوست داری بپرس یا درباره‌اش گپ بزن."}
                </p>
                <div className="suggestions">
                  {mode === "tutor" ? (
                    <>
                      <button type="button" onClick={() => setInput("کسرها را با مثال ساده و مرحله‌به‌مرحله به من یاد بده.")}>
                        ➗ آموزش یک موضوع
                      </button>
                      <button type="button" onClick={() => setInput("یک آزمون کوتاه از من بگیر و بعد جواب‌هایم را بررسی کن.")}>
                        📝 آزمون تمرینی
                      </button>
                      <button type="button" onClick={() => setInput("این موضوع را ساده توضیح بده و در پایان یک سؤال برای تمرین از من بپرس.")}>
                        💡 تمرین و یادگیری
                      </button>
                    </>
                  ) : (
                    <>
                      <button type="button" onClick={() => setInput("سلام! خودت را معرفی کن.")}>
                        👋 شروع گفت‌وگو
                      </button>
                      <button type="button" onClick={() => setInput("چند ایدهٔ خلاقانه و جالب پیشنهاد بده.")}>
                        ✨ ایده‌پردازی
                      </button>
                      <button type="button" onClick={() => setInput("این متن را خلاصه و ساده کن: ")}>
                        📝 کمک با متن
                      </button>
                    </>
                  )}
                </div>
              </div>
            ) : (
              <div className="messages">
                {activeChat.messages.map((message, index) => {
                  const messageKey = `${activeChat.id}-${index}`;
                  const isStreaming =
                    streamingMessageKey === messageKey &&
                    loadingChatId === activeChat.id;

                  return (
                    <div className={`message ${message.role}`} key={messageKey}>
                      <span className="message-label">
                        {message.role === "user"
                          ? "شما"
                          : mode === "tutor"
                            ? "معلم هوشمند"
                            : "Velora AI"}
                      </span>
                      <div
                        className={
                          message.role === "assistant"
                            ? "assistant-answer"
                            : "user-message-content"
                        }
                        dir="auto"
                      >
                        {message.role === "assistant" ? (
                          <>
                            <AssistantContent content={message.content} />
                            {isStreaming && (
                              <span className="streaming-cursor" aria-hidden="true">
                                ▍
                              </span>
                            )}
                          </>
                        ) : (
                          message.content
                        )}
                      </div>
                    </div>
                  );
                })}

                {loadingChatId === activeChat.id &&
                  !activeChat.messages.some(
                    (message, index) =>
                      message.role === "assistant" &&
                      streamingMessageKey === `${activeChat.id}-${index}`,
                  ) && (
                    <div className="message assistant">
                      <span className="message-label">
                        {mode === "tutor" ? "معلم هوشمند" : "Velora AI"}
                      </span>
                      <div className="assistant-answer">
                        {answerMode === "deep"
                          ? "در حال بررسی عمیق سؤال…"
                          : "در حال آماده‌کردن پاسخ…"}
                      </div>
                    </div>
                  )}
              </div>
            )}
          </section>

          <form
            className="composer"
            onSubmit={(event) => {
              event.preventDefault();
              void sendMessage();
            }}
          >
            <div className="answer-mode-picker" aria-label="حالت پاسخ‌گویی">
              <button
                className="answer-mode-button"
                type="button"
                aria-pressed={answerMode === "fast"}
                onClick={() => setAnswerMode("fast")}
                disabled={loadingChatId !== null}
                title="پاسخ سریع برای سؤال‌های معمولی"
              >
                ⚡ پاسخ سریع
              </button>

              <button
                className="answer-mode-button"
                type="button"
                aria-pressed={answerMode === "deep"}
                onClick={() => setAnswerMode("deep")}
                disabled={loadingChatId !== null}
                title="برای مسائل پیچیده و چندمرحله‌ای"
              >
                🧠 تفکر عمیق
              </button>

              <p className="answer-mode-description">
                {answerMode === "deep"
                  ? "تفکر عمیق فعال است؛ ممکن است پاسخ دیرتر آماده شود."
                  : "پاسخ سریع فعال است؛ مناسب سؤال‌های روزمره."}
              </p>
            </div>

            <textarea
              value={input}
              onChange={(event) => setInput(event.target.value)}
              onKeyDown={(event) => {
                if (event.key === "Enter" && !event.shiftKey) {
                  event.preventDefault();
                  void sendMessage();
                }
              }}
              placeholder={
                mode === "tutor"
                  ? "سؤالت رو بپرس تا با هم یاد بگیریم..."
                  : "پیامت رو بنویس..."
              }
              rows={1}
              aria-label="پیام شما"
            />

            <button
              className="send-button"
              type="submit"
              disabled={!input.trim() || loadingChatId !== null}
              aria-label="ارسال پیام"
            >
              ↑
            </button>

            <p className="composer-note">
              گفت‌وگوها در همین مرورگر ذخیره می‌شوند.
            </p>
          </form>
        </section>
      </main>
    </>
  );
}

export default App;
