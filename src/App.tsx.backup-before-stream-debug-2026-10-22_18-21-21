        .theme-light .assistant-answer li,
        .theme-light .assistant-answer blockquote,
        .theme-light .assistant-answer h1,
        .theme-light .assistant-answer h2,
        .theme-light .assistant-answer h3,
        .theme-light .assistant-answer h4,
        .theme-light .assistant-answer strong,
        .theme-light .assistant-answer em,
        .theme-light .assistant-answer td,
        .theme-light .assistant-answer th { color: #202336; }
        .theme-light .assistant-answer a { color: #5141c8; }
        .theme-light .assistant-answer blockquote { border-inline-start: 3px solid #c8c3f5; }
        .theme-light .assistant-answer pre {
          background: #eef0f6;
          color: #202336;
          border: 1px solid #dfe3ee;
          overflow-x: auto;
        }
        .theme-light .assistant-answer code { color: #8a285d; background: #f0edf7; }
        .theme-light .assistant-answer pre code { color: inherit; background: transparent; }
        .theme-light .assistant-answer table { border-color: #dfe3ee; }
        .theme-light .assistant-answer th,
        .theme-light .assistant-answer td { border-color: #dfe3ee; }
        .theme-light .user-message-content { color: #202336; }
        .theme-light .composer textarea { color: #202336; background: #ffffff; caret-color: #5141c8; }
        .theme-light .composer textarea::placeholder { color: #777d90; opacity: 1; }
        .code-block-wrapper {
          margin: 1rem 0;
          overflow: hidden;
          border: 1px solid var(--border-color, #dfe3ee);
