
import { useEffect, useState, type ReactNode } from "react";
import ReactMarkdown from "react-markdown";
import remarkGfm from "remark-gfm";
import remarkMath from "remark-math";
import rehypeKatex from "rehype-katex";
import "katex/dist/katex.min.css";
import "./App.css";

type Message = {
  role: "user" | "assistant";
  content: string;
};

type Chat = {
  id: string;
  title: string;
  messages: Message[];
  updatedAt: number;
};

type AnswerMode = "fast" | "deep";

const API_URL =
  "https://velora-ai-server.velora-ai-mohammad.workers.dev/api/chat";
const STORAGE_KEY = "velora-ai-chats-v1";
const THEME_KEY = "velora-study-theme-v1";
const ANSWER_MODE_KEY = "velora-ai-answer-mode-v1";

function createChat(): Chat {
  return {
    id: crypto.randomUUID(),
    title: "گفت‌وگوی جدید",
    messages: [],
    updatedAt: Date.now(),
  };
}

function loadChats(): Chat[] {
  try {
    const saved = localStorage.getItem(STORAGE_KEY);
    if (!saved) return [];

    const parsed: unknown = JSON.parse(saved);
    if (!Array.isArray(parsed)) return [];

    return parsed.filter(
      (item): item is Chat =>
        typeof item === "object" &&
        item !== null &&
        "id" in item &&
        typeof item.id === "string" &&
        "title" in item &&
        typeof item.title === "string" &&
        "messages" in item &&
        Array.isArray(item.messages) &&
        "updatedAt" in item &&
        typeof item.updatedAt === "number" &&
        item.messages.every(
          (message: unknown) =>
            typeof message === "object" &&
            message !== null &&
            "role" in message &&
            "content" in message &&
            (message.role === "user" || message.role === "assistant") &&
            typeof message.content === "string",
        ),
    );
  } catch {
    return [];
  }
}

function loadTheme(): "dark" | "light" {
  try {
    return localStorage.getItem(THEME_KEY) === "light" ? "light" : "dark";
  } catch {
    return "dark";
  }
}

function loadAnswerMode(): AnswerMode {
  try {
    return localStorage.getItem(ANSWER_MODE_KEY) === "deep"
      ? "deep"
      : "fast";
  } catch {
    return "fast";
  }
}

function normalizeMathText(content: string): string {
  const symbols: Record<string, string> = {
    "\\leftarrow": "←",
    "\\rightarrow": "→",
    "\\Rightarrow": "⇒",
    "\\Leftarrow": "⇐",
    "\\times": "×",
    "\\div": "÷",
    "\\pm": "±",
    "\\cdot": "·",
  };

  return content.replace(
    /\$(\\(?:leftarrow|rightarrow|Rightarrow|Leftarrow|times|div|pm|cdot))\$/g,
    (match, command: string) => symbols[command] ?? match,
  );
}

function extractText(node: ReactNode): string {
  if (typeof node === "string" || typeof node === "number") {
    return String(node);
  }

  if (Array.isArray(node)) {
    return node.map(extractText).join("");
  }

  if (node && typeof node === "object" && "props" in node) {
    return extractText(
      (node as { props?: { children?: ReactNode } }).props?.children,
    );
  }

  return "";
}

function CopyableCodeBlock({ children }: { children: ReactNode }) {
  const [copied, setCopied] = useState(false);
  const codeText = extractText(children);

  async function copyCode() {
    try {
      await navigator.clipboard.writeText(codeText);
      setCopied(true);
      window.setTimeout(() => setCopied(false), 1600);
    } catch {
      setCopied(false);
    }
  }

  return (
    <div className="code-block-wrapper" dir="ltr">
      <div className="code-block-toolbar">
        <span>Code</span>
        <button
          type="button"
          className="copy-code-button"
          onClick={() => void copyCode()}
          aria-label="کپی کد"
        >
          {copied ? "✓ کپی شد" : "⧉ کپی کد"}
        </button>
      </div>
      <pre dir="ltr">{children}</pre>
    </div>
  );
}

function AssistantContent({ content }: { content: string }) {
  const normalizedContent = normalizeMathText(content);

  return (
    <ReactMarkdown
      remarkPlugins={[remarkGfm, remarkMath]}
      rehypePlugins={[rehypeKatex]}
      components={{
        pre: ({ children }) => (
          <CopyableCodeBlock>{children}</CopyableCodeBlock>
        ),
        code: ({ children, className, ...props }) => (
          <code className={className} {...props}>
            {children}
          </code>
        ),
        a: ({ children, href, ...props }) => (
          <a href={href} target="_blank" rel="noreferrer" {...props}>
            {children}
          </a>
        ),
      }}
    >
      {normalizedContent}
    </ReactMarkdown>
  );
}

/**
 * پاسخ جریانی سرور را می‌خواند.
 * این تابع برای پروتکل NDJSON نوشته شده است:
 * هر خط باید یک JSON مستقل مثل {"delta":"سلام"} باشد.
 * سرور باید دقیقاً همین پروتکل را ارسال کند.
 */
async function readAnswerStream(
  response: Response,
  onText: (text: string) => void,
): Promise<string> {
  if (!response.body) {
    throw new Error("سرور جریان پاسخ را پشتیبانی نمی‌کند.");
  }

  const reader = response.body.getReader();
  const decoder = new TextDecoder();
  let buffer = "";
  let fullText = "";

  function processLine(line: string) {
    const trimmed = line.trim();
    if (!trimmed) return;

    const data = JSON.parse(trimmed) as {
      delta?: string;
      answer?: string;
      error?: string;
      done?: boolean;
    };

    if (data.error) {
      throw new Error(data.error);
    }

    // قرارداد اصلی جریان: هر پیام شامل delta است.
    if (typeof data.delta === "string" && data.delta.length > 0) {
      fullText += data.delta;
      onText(fullText);
    }

    // پشتیبانی اختیاری از پاسخ نهایی کامل.
    if (
      typeof data.answer === "string" &&
      !fullText &&
      data.answer.length > 0
    ) {
      fullText = data.answer;
      onText(fullText);
    }
  }

  try {
    while (true) {
      const { value, done } = await reader.read();

      if (done) break;

      buffer += decoder.decode(value, { stream: true });
      const lines = buffer.split("\n");
      buffer = lines.pop() ?? "";

      for (const line of lines) {
        processLine(line);
      }
    }

    buffer += decoder.decode();

    if (buffer.trim()) {
      processLine(buffer);
    }
  } catch (error) {
    try {
      await reader.cancel();
    } catch {
      // نادیده‌گرفتن خطای لغو خواندن
    }

    throw error;
  } finally {
    reader.releaseLock();
  }

  if (!fullText.trim()) {
    throw new Error("سرور پاسخ معتبری برنگرداند.");
  }

  return fullText;
}

function App() {
  const [chats, setChats] = useState<Chat[]>(() => {
    const saved = loadChats();
    return saved.length > 0 ? saved : [createChat()];
  });

  const [activeChatId, setActiveChatId] = useState(
    () => loadChats()[0]?.id ?? "",
  );
  const [theme, setTheme] = useState<"dark" | "light">(loadTheme);
  const [mode, setMode] = useState<"chat" | "tutor">("tutor");
  const [answerMode, setAnswerMode] = useState<AnswerMode>(loadAnswerMode);
  const [input, setInput] = useState("");
  const [loadingChatId, setLoadingChatId] = useState<string | null>(null);
  const [sidebarOpen, setSidebarOpen] = useState(true);
  const [streamingMessageKey, setStreamingMessageKey] = useState<string | null>(
    null,
  );

  const activeChat = chats.find((chat) => chat.id === activeChatId) ?? chats[0];

  useEffect(() => {
    if (!activeChatId && chats[0]) {
      setActiveChatId(chats[0].id);
    }
  }, [activeChatId, chats]);

  useEffect(() => {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(chats));
    } catch {
      console.error("ذخیرهٔ گفت‌وگوها ناموفق بود.");
    }
  }, [chats]);

  useEffect(() => {
    try {
      localStorage.setItem(THEME_KEY, theme);
    } catch {
      console.error("ذخیرهٔ تم ناموفق بود.");
    }
  }, [theme]);

  useEffect(() => {
    try {
      localStorage.setItem(ANSWER_MODE_KEY, answerMode);
    } catch {
      console.error("ذخیرهٔ حالت پاسخ ناموفق بود.");
    }
  }, [answerMode]);

  function updateChat(chatId: string, updater: (chat: Chat) => Chat) {
    setChats((previous) =>
      previous.map((chat) => (chat.id === chatId ? updater(chat) : chat)),
    );
  }

  function startNewChat() {
    const chat = createChat();

    setChats((previous) => [chat, ...previous]);
    setActiveChatId(chat.id);
    setInput("");
    setStreamingMessageKey(null);
  }

  async function sendMessage(overrideText?: string) {
    const text = (overrideText ?? input).trim();

    if (!text || !activeChat || loadingChatId) return;

    const chatId = activeChat.id;
    const updatedMessages: Message[] = [
      ...activeChat.messages,
      { role: "user", content: text },
    ];

    setStreamingMessageKey(null);

    updateChat(chatId, (chat) => ({
      ...chat,
      title:
        chat.messages.length === 0
          ? text.slice(0, 35) + (text.length > 35 ? "…" : "")
          : chat.title,
      messages: updatedMessages,
      updatedAt: Date.now(),
    }));

    setInput("");
    setLoadingChatId(chatId);

    const assistantMessageIndex = updatedMessages.length;

    // پیام خالی دستیار را از ابتدا ایجاد می‌کنیم تا متن جریانی
    // هم‌زمان با رسیدن از سرور نمایش داده شود.
    updateChat(chatId, (chat) => ({
      ...chat,
      messages: [
        ...chat.messages,
        { role: "assistant", content: "" },
      ],
      updatedAt: Date.now(),
    }));

    setStreamingMessageKey(`${chatId}-${assistantMessageIndex}`);

    try {
      const apiMessages = updatedMessages.slice(-20).map((message, index, messages) => {
        if (
          mode !== "tutor" ||
          index !== messages.length - 1 ||
          message.role !== "user"
        ) {
          return message;
        }

        return {
          ...message,
          content:
            `${message.content}\n\n` +
            "راهنمای پاسخ‌گویی: مثل یک معلم خصوصی صبور و مهربان آموزش بده. " +
            "موضوع را ساده و مرحله‌به‌مرحله توضیح بده، در صورت نیاز مثال بزن، " +
            "و به‌جای فقط گفتن جواب، کمک کن کاربر دلیل و روش را یاد بگیرد. " +
            "اگر سؤال درسی نیست، همچنان دقیق و روشن پاسخ بده.",
        };
      });

      const response = await fetch(API_URL, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "Accept": "application/x-ndjson",
        },
        body: JSON.stringify({
          messages: apiMessages,
          answerMode,
          stream: true,
        }),
      });

      if (!response.ok) {
        let errorMessage = "دریافت پاسخ ناموفق بود.";

        try {
          const errorData = (await response.json()) as { error?: string };
          if (errorData.error) errorMessage = errorData.error;
        } catch {
          // بدنهٔ خطا JSON نبود
        }

        throw new Error(errorMessage);
      }

      const answer = await readAnswerStream(response, (partialText) => {
        updateChat(chatId, (chat) => ({
          ...chat,
          messages: chat.messages.map((message, index) =>
            index === assistantMessageIndex && message.role === "assistant"
              ? { ...message, content: partialText }
              : message,
          ),
          updatedAt: Date.now(),
        }));
      });

      // اطمینان از ذخیره پاسخ نهایی
      updateChat(chatId, (chat) => ({
        ...chat,
        messages: chat.messages.map((message, index) =>
          index === assistantMessageIndex && message.role === "assistant"
            ? { ...message, content: answer }
            : message,
        ),
        updatedAt: Date.now(),
      }));
    } catch (error) {
      const errorMessage =
        error instanceof Error
          ? error.message
          : "ارتباط با سرور برقرار نشد.";

      updateChat(chatId, (chat) => ({
        ...chat,
        messages: chat.messages.map((message, index) =>
          index === assistantMessageIndex && message.role === "assistant"
            ? {
                ...message,
                content: `**خطا در دریافت پاسخ**\n\n${errorMessage}`,
              }
            : message,
        ),
        updatedAt: Date.now(),
      }));
    } finally {
      setLoadingChatId((current) => (current === chatId ? null : current));
      setStreamingMessageKey(null);
    }
  }

  function deleteChat(chatId: string) {
    const remaining = chats.filter((chat) => chat.id !== chatId);

    if (remaining.length === 0) {
      const newChat = createChat();

      setChats([newChat]);
      setActiveChatId(newChat.id);
      setInput("");
      setStreamingMessageKey(null);
      return;
    }

    setChats(remaining);

    if (activeChatId === chatId) {
      setActiveChatId(remaining[0].id);
      setInput("");
    }
  }

  return (
    <>
